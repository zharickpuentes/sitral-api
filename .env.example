# Copie este archivo como .env y ajuste los valores. NUNCA suba .env al repositorio.
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://sitral:sitral_pwd@localhost:3306/sitral?charset=utf8mb4
AUTO_CREATE_TABLES=true

# Genere una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-.env
ACCESS_TOKEN_EXPIRE_MINUTES=60

TIMEZONE=America/Bogota
DEFAULT_ALERT_THRESHOLD_DAYS=30
ALERT_JOB_ENABLED=true
ALERT_JOB_INTERVAL_HOURS=24

CORS_ORIGINS=["*"]

# Asistente IA (endpoint /api/v1/ai) — clave de https://aistudio.google.com
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=10

# Datos abiertos colombianos (Guía 6) — API SODA de datos.gov.co
DATOS_ABIERTOS_BASE_URL=https://www.datos.gov.co/resource
# Opcional: App Token gratuito de datos.gov.co (sube el límite de solicitudes). Nunca lo suba al repositorio.
SOCRATA_APP_TOKEN=
DATASET_CUM_ID=i7cb-raxc
DATASET_DIVIPOLA_ID=gdxc-w37w
OPENDATA_TIMEOUT_SECONDS=10
OPENDATA_CACHE_DIR=data/opendata

# Resiliencia: circuit breaker y reintentos con backoff exponencial
CB_FAILURE_THRESHOLD=3
CB_RECOVERY_SECONDS=20
RETRY_ATTEMPTS=3
RETRY_BASE_SECONDS=0.5

# Analítica DuckDB: cuántos principios activos consultar en el CUM
ANALYTICS_MAX_PRINCIPIOS=8
